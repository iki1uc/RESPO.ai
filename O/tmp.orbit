// =======================================
// DEEP SPACE NINE – Wurmloch Gate
// =======================================

export function DS9_WormholeGate(score){

    const open = (score % 7) > 3;
    const stability = (Math.sin(score) + 1) * 50;

    return {
        open,
        stability,
        gatePower: score * stability
    };
}

// =======================================
// DEEP SPACE NINE – Orbit Station
// =======================================

export function DS9_StationOrbit(scene){

    const geo = new THREE.TorusGeometry(1.8, 0.15, 16, 100);
    const mat = new THREE.MeshBasicMaterial({ color: 0xccccff, wireframe:true });
    const station = new THREE.Mesh(geo, mat);

    station.position.x = 6;
    scene.add(station);

    return function animateStation(){
        station.rotation.y += 0.002;
        station.rotation.x += 0.001;
    };
}

