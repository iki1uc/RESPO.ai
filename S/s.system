import { OrbitCompute } from "../O/tmp.orbit.js";
import { DS9_WormholeGate } from "../D/tmp.station.js";
import { OPTA } from "./opta.vector.js";

export function S_SystemCompute(input){

    const orbit = OrbitCompute(input);
    const gate = DS9_WormholeGate(orbit.score);

    return {
        orbit,
        gate,
        opta: OPTA.stageEnter("S")
    };
}
