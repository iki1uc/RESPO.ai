// =======================================
// WÜRFEL.LOAD · NC-L → NC-R · EVO-Upgrade
// =======================================

// 1. Matrix laden (NEU)
import { RESPO_MATRIX } from "./cubemind.js";

// 2. RAW-AxiomEngine (NEU)
import { AxiomEngine } from "./ai.js";

// 3. CubeMind (NEU)
import { CubeMind } from "./cubemind.js";

// 4. Triangle (NEU)
import { AxiomTriangle } from "./axiom.triangle.js";

// 5. Channel (NEU)
import { RESPO_CHANNEL } from "./axiom.channel.js";

// =======================================
// NC-Status prüfen
// =======================================

const NC = {
    left: [
        "altname-neuname-13.csv",
        "bewegung-mau-raw-9.csv",
        "datei-funktion-6.csv",
        "grad-evo-8.csv",
        "menschentyp-wahrheit-4.csv",
        "operator-rolle-6.csv",
        "symbol-bedeutung-11.csv",
        "symbol-raw-bedeutung-10.csv",
        "verkehr-achse-3.csv",
        "zustand-ai-6.csv",
        "756.js",
        "81.js"
    ],
    right: [
        "ai.js",
        "cubemind.js",
        "axiom.alpha.js",
        "axiom.beta.js",
        "axiom.gamma.js",
        "axiom.triangle.js",
        "axiom.channel.js",
        "index.html",
        "ID.html",
        "README.md"
    ]
};

// =======================================
// NC-Auswertung
// =======================================

function NC_Check() {
    return {
        alt: NC.left.length,
        neu: NC.right.length,
        status: NC.right.length > NC.left.length ? "EVO aktiv" : "ALT aktiv"
    };
}

// =======================================
// WÜRFEL · LADEN
// =======================================

export function WuerfelLoad() {

    const nc = NC_Check();

    console.log("NC-L (ALT):", nc.alt);
    console.log("NC-R (NEU):", nc.neu);
    console.log("Status:", nc.status);

    // Engine starten
    const engine = new AxiomEngine(RESPO_MATRIX);
    const cube = new CubeMind(engine);

    const cubeScore = cube.runCubeMind();

    // Dreieck
    const tri = new AxiomTriangle();
    const triScore = tri.triangle(cubeScore);

    // Kanal
    const HY  = RESPO_CHANNEL.HY(triScore);
    const PE  = RESPO_CHANNEL.PE(triScore);
    const PER = RESPO_CHANNEL.PER(triScore);

    return {
        cubeScore,
        triScore,
        HY,
        PE,
        PER,
        NC_Status: nc.status
    };
}

